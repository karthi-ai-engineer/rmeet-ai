   "updated": 1764000000000,
   "link": null,
   "locked": false,
   "text": "TIME (estimates, to be measured)\n\nend of speech -> text:  ~0.4-0.8 s\nanswer in chat:  3-7 s\nspoken answer:  3-5 s (simple), 5-8 s (needs search)\n\"One sec, checking...\" said at once if slower",
   "originalText": "TIME (estimates, to be measured)\n\nend of speech -> text:  ~0.4-0.8 s\nanswer in chat:  3-7 s\nspoken answer:  3-5 s (simple), 5-8 s (needs search)\n\"One sec, checking...\" said at once if slower",
   "fontSize": 15,
   "fontFamily": 2,
   "textAlign": "center",
   "verticalAlign": "middle",
   "containerId": null,
   "lineHeight": 1.25,
   "autoResize": true
