   "boundElements": [],
   "updated": 1764000000000,
   "link": null,
   "locked": false,
   "text": "RULES\n\nMax speaks only when spoken to, never over people\nSpoken = 1-2 sentences; details, sources, lists -> chat\nNever acts on a voice request alone: confirm card in chat\n\"What did I miss?\" -> private recap from the meeting state",
   "originalText": "RULES\n\nMax speaks only when spoken to, never over people\nSpoken = 1-2 sentences; details, sources, lists -> chat\nNever acts on a voice request alone: confirm card in chat\n\"What did I miss?\" -> private recap from the meeting state",
   "fontSize": 15,
   "fontFamily": 2,
   "textAlign": "center",
   "verticalAlign": "middle",
   "containerId": null,
   "lineHeight": 1.25,
