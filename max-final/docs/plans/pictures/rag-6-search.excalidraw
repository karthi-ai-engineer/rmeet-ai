  {
   "id": "te32",
   "type": "text",
   "x": 149.59999999999997,
   "y": 648.75,
   "width": 520.8000000000001,
   "height": 112.5,
   "angle": 0,
   "strokeColor": "#1e1e1e",
   "backgroundColor": "transparent",
   "fillStyle": "solid",
   "strokeWidth": 2,
