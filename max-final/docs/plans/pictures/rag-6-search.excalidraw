   "boundElements": [],
   "updated": 1764000000000,
   "link": null,
   "locked": false,
   "text": "SPEED, COST, MODELS\n\nRe-rank: about 1-2 s and ~$0.0015 per question; any model can do it\nOn a GPU machine or server: a local re-rank model can replace it\nMeaning search: gemini-embedding-2 now; open backup Qwen3-Embedding-0.6B\nSteps 1, 5 and 7 are on by default; the test set must prove they help",
   "originalText": "SPEED, COST, MODELS\n\nRe-rank: about 1-2 s and ~$0.0015 per question; any model can do it\nOn a GPU machine or server: a local re-rank model can replace it\nMeaning search: gemini-embedding-2 now; open backup Qwen3-Embedding-0.6B\nSteps 1, 5 and 7 are on by default; the test set must prove they help",
   "fontSize": 15,
   "fontFamily": 2,
   "textAlign": "center",
   "verticalAlign": "middle",
   "containerId": null,
   "lineHeight": 1.25,
   "autoResize": true
  },
