   "roughness": 1,
   "opacity": 100,
   "groupIds": [],
   "frameId": null,
   "roundness": null,
   "seed": 1811180650,
   "version": 1,
   "versionNonce": 168393880,
   "isDeleted": false,
   "boundElements": [],
   "updated": 1764000000000,
   "link": null,
   "locked": false,
   "text": "WHY THE RE-RANK STEP (5)\n\nSearch finds pieces that LOOK similar to the question.\nRe-rank reads each one next to the question and keeps the ones\nthat really ANSWER it. In studies this is the biggest single\naccuracy gain after hybrid search.",
   "originalText": "WHY THE RE-RANK STEP (5)\n\nSearch finds pieces that LOOK similar to the question.\nRe-rank reads each one next to the question and keeps the ones\nthat really ANSWER it. In studies this is the biggest single\naccuracy gain after hybrid search.",
   "fontSize": 15,
   "fontFamily": 2,
   "textAlign": "center",
   "verticalAlign": "middle",
   "containerId": null,
   "lineHeight": 1.25,
   "autoResize": true
  },
