# Copy this file to .env and fill in your values. Never commit .env.
# Limits (budgets, time limits, message limits...) are NOT here: see limits.toml / data/limits.toml.

# ---- AI provider (Max stays swappable: change these lines, no code changes) ----
# gemini              = Google Gemini (default)
# openai_compatible   = any OpenAI-style server: company Qwen on vLLM, other open models, ...
LLM_PROVIDER=gemini
LLM_API_KEY=
# Main model and backup model (Gemini defaults: gemini-3.1-flash-lite and gemini-3.5-flash-lite).
# Leave them out (or empty) to use the defaults.
# LLM_MODEL=
# LLM_FALLBACK_MODEL=

# Only for openai_compatible: the server address and optional extra request fields (JSON)
# LLM_BASE_URL=http://gpu-server:8000/v1
# LLM_EXTRA_BODY={"chat_template_kwargs": {"enable_thinking": false}}
# Company Qwen gateway (not used for now, no access): LLM_MODEL=unsloth/Qwen3.8-27B-NVFP4

# The Step 0 names GEMINI_API_KEY / GEMINI_MODEL / GEMINI_FALLBACK_MODEL still work, for Gemini only
# (a Gemini key is never sent to another provider).

# ---- Local voice server (Kokoro on this PC) ----
TTS_PROVIDER=local
LOCAL_TTS_URL=http://localhost:8400
