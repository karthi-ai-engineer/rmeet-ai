# Copy this file to .env and paste your key. Never commit .env.

# Gemini (the only model provider for now)
GEMINI_API_KEY=
# Main model: cheapest first
GEMINI_MODEL=gemini-3.1-flash-lite
# Backup model if the main one fails or hits its limit (separate limits)
GEMINI_FALLBACK_MODEL=gemini-3.5-flash-lite

# Local voice server (Kokoro on this PC)
TTS_PROVIDER=local
LOCAL_TTS_URL=http://localhost:8400

# Company Qwen gateway: NOT USED for now (no access). Kept for later.
# TW_BASE_URL=
# TW_API_KEY=
# TW_MODEL=unsloth/Qwen3.8-27B-NVFP4
