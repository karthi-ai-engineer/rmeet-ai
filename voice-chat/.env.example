# Copy this file to ".env" (same folder) and paste your keys.
# This is the ONE place model keys live: simulations/teams/register_app.py copies them into max/.env.

# Gemini (speech-to-text, text-to-speech). Key: https://aistudio.google.com/apikey
GEMINI_API_KEY=paste-your-gemini-key-here
GEMINI_MODEL=gemini-3.5-flash-lite

# Optional per-machine switches (defaults: Qwen brain, Gemini voices). Uncomment to change.
# Brain on Gemini instead of the company Qwen (machines without the Qwen key):
# BRAIN_PROVIDER=gemini
# GEMINI_BRAIN_MODEL=gemini-3.1-flash-lite
# GEMINI_NOTES_MODEL=   (optional: a different Gemini model just for meeting notes; empty = brain model)
# Voices from a local voice server (POST /tts {text, voice, style} -> WAV) instead of Gemini TTS:
# TTS_PROVIDER=local
# LOCAL_TTS_URL=http://127.0.0.1:8400

# Company Qwen gateway (all thinking/answers). Ask Karthi for the key.
TW_API_KEY=paste-your-company-gateway-key-here
TW_BASE_URL=https://tw-gateway.twave.co.jp/v1
TW_MODEL=unsloth/Qwen3.8-27B-NVFP4

# Optional
# PORT=8000
